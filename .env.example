# Nexus sikkerhedstoken — skift dette til en stærk secret i produktion
NEXUS_TOKEN=change-this-to-a-strong-secret-in-production

# Tilladte origins for CORS (komma-separeret)
ALLOWED_ORIGINS=http://localhost:8666,http://localhost:8667,http://localhost:8668,http://localhost:8669,http://localhost:8671

# Registry service URL (bruges af Angular apps ved build)
REGISTRY_URL=http://localhost:8670

# URL til host's remoteEntry.json (bruges af app)
HOST_REMOTE_ENTRY=http://localhost:8667/remoteEntry.json

# ============================================================================
# Portal (nexus-portal) — auth and session config
# ============================================================================

# Required. Random string used to sign session cookies. Generate with:
#   openssl rand -hex 32
# Rotating this invalidates all active sessions on the next portal restart.
PORTAL_SESSION_SECRET=change-this-to-a-strong-random-string

# Required ONLY the first time the portal starts against an empty
# /data/portal.db volume. Seeds the initial admin user with this password and
# forces a password change at first login. Leave unset after the first run.
PORTAL_INITIAL_PASSWORD=
